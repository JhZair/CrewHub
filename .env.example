# Copia este archivo como .env.local y completa los valores.
# En produccion: Vercel > Settings > Environment Variables.


# ── OBLIGATORIAS: sin esto la app no arranca ─────────────────
# Supabase > Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=https://TU-PROYECTO.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...

# Correos del equipo separados por coma (allowlist, la lee middleware.ts)
ALLOWED_EMAILS=correo1@gmail.com,correo2@gmail.com,correo3@gmail.com


# ── Cron SUNAT e ingesta ─────────────────────────────────────
# Supabase > Project Settings > API > service_role (SECRETA, salta el RLS)
SUPABASE_SERVICE_ROLE_KEY=eyJ...
# Consulta de RUC: decolecta / apis.net.pe
SUNAT_API_TOKEN=


# ── Secretos de endpoints (inventa cadenas largas aleatorias) ─
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
CRON_SECRET=
PUSH_CRON_LLAVE=
INGESTA_DAFO_LLAVE=


# ── Notificaciones push (VAPID) ──────────────────────────────
# Generar el par:  node -e "console.log(require('web-push').generateVAPIDKeys())"
# Cambiar el par invalida las suscripciones push ya registradas.
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:tu-correo@gmail.com
